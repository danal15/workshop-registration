<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j 2 configuration for workshop-cli: everything at info level and above goes to the console.
  The level can be changed without rebuilding: java -Dworkshop.log.level=warn -jar workshop-cli.jar
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="${sys:workshop.log.level:-info}">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
